# Safe local Compose example. Never put real credentials in this file.
# Empty means admin settings/history are disabled.
# Generate a private random ADMIN_TOKEN and store it in .env or Render Environment.
ADMIN_TOKEN=
STORE_ANALYSIS_IMAGES=false
IMAGE_RETENTION_DAYS=7
MAX_CONCURRENT_ANALYSES=2

# Relative to the VisionGate project root; no lookup in other projects.
SAMSUNG_ARCHIVE_DIR=data/Samsung/original
# Optional local pretrained OCR; no network inference or automatic model download.
SAMSUNG_OCR_ENGINE=legacy
SAMSUNG_OCR_DETECTOR=mobile
SAMSUNG_ENABLED=true
SAMSUNG_RECOGNITION_PROFILE=enhanced
SAMSUNG_POLICY_PROFILE=role-v1
