FROM node:24-alpine AS frontend-build
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.13-slim AS runtime
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ backend/
COPY config/ config/
COPY deploy/start.sh /app/start.sh
COPY --from=frontend-build /build/dist /app/frontend/dist
RUN useradd --create-home gate && mkdir -p /app/data && chown gate:gate /app/data && chmod 700 /app/data && chmod 755 /app/start.sh
ENV PORT=10000 HISTORY_DB=/app/data/history.sqlite3 GATE_CONFIG=/app/data/thresholds.json STORE_ANALYSIS_IMAGES=false PRIVATE_IMAGE_DIR=/app/data/private-images MAX_CONCURRENT_ANALYSES=1 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER gate
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','10000')+'/api/v1/health',timeout=4)"
CMD ["/app/start.sh"]
